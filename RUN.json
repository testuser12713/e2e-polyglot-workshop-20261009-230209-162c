{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "valkey",
      "kind": "database",
      "engine": "valkey"
    },
    {
      "name": "worker",
      "dir": "worker",
      "stack": "python",
      "kind": "worker",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "main.py"
      ],
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ],
      "env": {
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "VALKEY_URL": {
          "dev": "${service:valkey.url}"
        },
        "HOURLY_RATE_CENTS": {
          "dev": "8900"
        }
      }
    },
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "static",
      "install": [
        [
          "npm",
          "ci",
          "--no-audit",
          "--no-fund"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "start": [
        "npm",
        "run",
        "preview",
        "--",
        "--port",
        "${PORT}",
        "--host"
      ],
      "test": [
        [
          "npm",
          "test"
        ]
      ],
      "serve_dir": "dist",
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "go",
      "kind": "server",
      "install": [
        [
          "go",
          "mod",
          "download"
        ]
      ],
      "build": [
        [
          "go",
          "build",
          "./..."
        ]
      ],
      "start": [
        "go",
        "run",
        "."
      ],
      "test": [
        [
          "go",
          "test",
          "./..."
        ]
      ],
      "port": 8000,
      "port_env": "API_PORT",
      "health": {
        "path": "/healthz",
        "expect_status": [
          200
        ]
      },
      "depends_on": [
        "db",
        "valkey"
      ],
      "env": {
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "VALKEY_URL": {
          "dev": "${service:valkey.url}"
        },
        "WEB_ORIGIN": {
          "dev": "${service:web.origin}"
        },
        "EMPLOYEE_BOOTSTRAP_EMAIL": {
          "dev": "werkstatt@example.com",
          "not_secret": true,
          "why": "Login identity of the seeded workshop employee, deliberately public so a person who clones the repo knows which e-mail to sign in with; the paired EMPLOYEE_BOOTSTRAP_PASSWORD is the secret."
        },
        "EMPLOYEE_BOOTSTRAP_PASSWORD": {
          "generate": "hex",
          "bytes": 24
        }
      }
    }
  ]
}
