# Kfz-Werkstatt-Kundenportal — API

# Startkonfiguration der API. Kopieren Sie diese Datei nach `.env`, setzen Sie
# die Werte und exportieren Sie sie vor dem Start (siehe README).
#
# Pflichtwerte (die API startet nicht ohne sie):
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app
VALKEY_URL=redis://127.0.0.1:6379/0

# Optional (mit Vorgabewert):
WEB_ORIGIN=http://localhost:5173
API_PORT=8000

# Vom Runner pro Lauf gewürfelte Werte — tragen Sie hier ein eigenes Geheimnis
# ein, wenn Sie die API von Hand starten. NIE im Repository ablegen.
EMPLOYEE_BOOTSTRAP_EMAIL=werkstatt@example.com
EMPLOYEE_BOOTSTRAP_PASSWORD=
